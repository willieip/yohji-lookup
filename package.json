{
  "name": "yohji-lookup",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A source-backed index of Yohji Yamamoto product codes and garments.",
  "scripts": {
    "start": "python3 -m http.server 8765 --bind 127.0.0.1",
    "test": "node --test tests/lookup.test.mjs",
    "test:import": "python3 -m unittest discover -s tests -p 'test_import_catalog.py' -v",
    "test:browser": "node tests/browser.mjs",
    "refresh": "python3 scripts/import-catalog.py"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
